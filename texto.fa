# módulo: texto
# Descripción: utilidades de texto que NO duplican builtins.
#
# Los builtins del lenguaje ya cubren longitud, a_mayusculas, a_minusculas,
# contiene, reemplazar, invertir, recortar y subcadena. Este módulo solo agrega
# lo que falta. (Antes redefinía esos nombres y, al importarse, los pisaba.)

funcion capitalizar(s) {
    si (longitud(s) == 0) {
        retornar s
    }
    variable primero = a_mayusculas(s[0])
    variable resto = subcadena(s, 1, longitud(s) - 1)
    retornar primero + resto
}

funcion contar_ocurrencias(texto, patron) {
    variable contador = 0
    variable i = 0
    variable lp = longitud(patron)
    mientras (i <= longitud(texto) - lp) {
        si (subcadena(texto, i, lp) == patron) {
            contador = contador + 1
            i = i + lp
        } sino {
            i = i + 1
        }
    }
    retornar contador
}

funcion esta_vacio(s) {
    retornar longitud(s) == 0
}

funcion repetir_texto(s, veces) {
    variable resultado = ""
    variable i = 0
    mientras (i < veces) {
        resultado = resultado + s
        i = i + 1
    }
    retornar resultado
}
