# módulo: url
# Parseo y construcción segura de URLs
# Uso: importar std/url

importar std/resultado

clase ErrorUrl {
    mensaje: Texto;
    codigo: Entero;
    constructor(m: Texto, c: Entero) {
        este.mensaje = m;
        este.codigo = c;
    }
}

# Devuelve Ok(mapa) con las claves: esquema, host, puerto, ruta, query.
funcion parsear(url: Texto) -> Resultado<Mapa<Texto, Texto>, ErrorUrl> {
    retornar Ok(_url_parsear(url));
}

funcion construir(esquema: Texto, host: Texto, puerto: Entero, ruta: Texto, query: Texto) -> Texto {
    retornar _url_construir(esquema, host, puerto, ruta, query);
}

funcion codificar(texto: Texto) -> Texto {
    retornar _url_codificar(texto);
}

funcion decodificar(texto: Texto) -> Texto {
    retornar _url_decodificar(texto);
}

# Devuelve Ok(mapa) con cada parámetro de la query ya decodificado.
funcion query_parsear(query: Texto) -> Resultado<Mapa<Texto, Texto>, ErrorUrl> {
    retornar Ok(_query_parsear(query));
}
