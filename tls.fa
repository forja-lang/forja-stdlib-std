# módulo: tls
# Capa de seguridad en transporte (TLS/SSL)
# Uso: importar "std/tls"

importar "std/resultado"

clase ErrorTLS {
    mensaje: Texto;
    codigo: Entero;
    constructor(m: Texto, c: Entero) {
        este.mensaje = m;
        este.codigo = c;
    }
}

funcion conectar(host: Texto, puerto: Entero) -> Resultado<Entero, ErrorTLS> {
    retornar _tls_conectar(host, puerto);
}

funcion conectar_con_pin(host: Texto, puerto: Entero, pin_sha256: Texto) -> Resultado<Entero, ErrorTLS> {
    retornar _tls_conectar_con_pin(host, puerto, pin_sha256);
}

funcion enviar(conn: Entero, datos: Texto) -> Resultado<Entero, ErrorTLS> {
    retornar _tls_enviar(conn, datos);
}

funcion recibir(conn: Entero, tamano: Entero) -> Resultado<Texto, ErrorTLS> {
    retornar _tls_recibir(conn, tamano);
}

funcion cerrar(conn: Entero) {
    _tls_cerrar(conn);
}
