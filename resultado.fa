// Tipos algebraicos del prelude de Forja
// ======================================
//
// El compilador define, sin necesidad de importar nada:
//
//   Resultado<T, E> = Ok(T) | Error(E)
//   Opcion<T>       = Alguno(T) | Ninguno
//
// Constructores disponibles globalmente: `Ok`, `Error`, `Algo`/`Alguno`,
// `Ninguno`/`Nada`.
//
// El operador `?` desenvuelve un `Ok`/`Alguno` o propaga el `Error`/`Ninguno`
// al llamador, y sólo puede usarse dentro de una función cuyo tipo de retorno
// sea `Resultado` u `Opcion`.
//
// Este módulo aporta helpers para inspeccionar esos valores sin escribir un
// `coincidir` explícito. El parámetro de entrada es genérico (puede ser
// `Resultado` u `Opcion`), por eso el patrón comodín cubre el resto.

// ¿El valor es un éxito (`Ok`/`Alguno`)?
funcion es_ok(valor) -> Booleano {
    coincidir (valor) {
        caso Ok(_) -> { retornar verdadero }
        caso Alguno(_) -> { retornar verdadero }
        caso _ -> { retornar falso }
    }
}

// ¿El valor es un error o una ausencia (`Error`/`Ninguno`)?
funcion es_error(valor) -> Booleano {
    retornar no es_ok(valor)
}

// Devuelve el contenido, o `por_defecto` si no hay valor.
funcion desenvolver_o(valor, por_defecto) {
    coincidir (valor) {
        caso Ok(v) -> { retornar v }
        caso Alguno(v) -> { retornar v }
        caso _ -> { retornar por_defecto }
    }
}

// Devuelve el contenido, o `nulo` si no hay valor.
funcion desenvolver(valor) {
    retornar desenvolver_o(valor, nulo)
}
