# módulo: hash
# Funciones hash criptográficas y HMAC
#
# Uso: importar "std/hash"
#
# Proporciona:
#   - sha1(datos)                  — SHA-1 (160 bits, 40 hex)
#   - sha224(datos)                — SHA-224 (224 bits, 56 hex)
#   - sha256(datos)                — SHA-256 (256 bits, 64 hex)
#   - sha384(datos)                — SHA-384 (384 bits, 96 hex)
#   - sha512(datos)                — SHA-512 (512 bits, 128 hex)
#   - hmac_sha256(clave, datos)    — HMAC-SHA256 (256 bits, 64 hex)

clase ErrorHash {
    mensaje: Texto
    codigo: Entero
}

# Calcula SHA-1 de un texto, retorna hash hexadecimal (40 caracteres en minúscula)
funcion sha1(datos: Texto) -> Resultado<Texto, ErrorHash> {
    si (datos == "") {
        retornar Error(nuevo ErrorHash("Los datos no pueden estar vacíos", -1))
    }
    retornar Ok(_sha1(datos))
}

# Calcula SHA-224 de un texto, retorna hash hexadecimal (56 caracteres en minúscula)
funcion sha224(datos: Texto) -> Resultado<Texto, ErrorHash> {
    si (datos == "") {
        retornar Error(nuevo ErrorHash("Los datos no pueden estar vacíos", -1))
    }
    retornar Ok(_sha224(datos))
}

# Calcula SHA-256 de un texto, retorna hash hexadecimal (64 caracteres en minúscula)
funcion sha256(datos: Texto) -> Resultado<Texto, ErrorHash> {
    si (datos == "") {
        retornar Error(nuevo ErrorHash("Los datos no pueden estar vacíos", -1))
    }
    retornar Ok(_sha256(datos))
}

# Calcula SHA-384 de un texto, retorna hash hexadecimal (96 caracteres en minúscula)
funcion sha384(datos: Texto) -> Resultado<Texto, ErrorHash> {
    si (datos == "") {
        retornar Error(nuevo ErrorHash("Los datos no pueden estar vacíos", -1))
    }
    retornar Ok(_sha384(datos))
}

# Calcula SHA-512 de un texto, retorna hash hexadecimal (128 caracteres en minúscula)
funcion sha512(datos: Texto) -> Resultado<Texto, ErrorHash> {
    si (datos == "") {
        retornar Error(nuevo ErrorHash("Los datos no pueden estar vacíos", -1))
    }
    retornar Ok(_sha512(datos))
}

# Calcula HMAC-SHA256 de un mensaje con una clave
# clave: texto usado como clave secreta
# datos: mensaje a autenticar
# Retorna: hash hexadecimal HMAC-SHA256 (64 caracteres en minúscula)
funcion hmac_sha256(clave: Texto, datos: Texto) -> Resultado<Texto, ErrorHash> {
    si (clave == "" || datos == "") {
        retornar Error(nuevo ErrorHash("Clave y datos no pueden estar vacíos", -1))
    }
    retornar Ok(_hmac_sha256(clave, datos))
}
