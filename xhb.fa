# módulo: xhb
# Descripción: Parseo y serialización de archivos HomeBank XHB (Finanzas Personales XML)
#
# Uso: importar "std/xhb"

importar "std/archivo"

clase ErrorXHB {
    mensaje
    codigo

    constructor(mensaje, codigo) {
        este.mensaje = mensaje
        este.codigo = codigo
    }
}

clase MonedaXHB {
    key
    iso
    nombre
    simbolo
    banderas
    simbolo_prefijo
    decimal_char
    grupo_char
    fraccion
    tasa
    mdate

    constructor(key, iso, nombre, simbolo) {
        este.key = key
        este.iso = iso
        este.nombre = nombre
        este.simbolo = simbolo
        este.banderas = 0
        este.simbolo_prefijo = 1
        este.decimal_char = "."
        este.grupo_char = ","
        este.fraccion = 2
        este.tasa = 0.0
        este.mdate = 0
    }
}

clase CuentaXHB {
    key
    posicion
    tipo
    moneda_key
    nombre
    numero
    banco
    saldo_inicial
    saldo_minimo
    cheque1
    cheque2

    constructor(key, nombre, tipo, moneda_key) {
        este.key = key
        este.nombre = nombre
        este.tipo = tipo
        este.moneda_key = moneda_key
        este.posicion = 1
        este.numero = ""
        este.banco = ""
        este.saldo_inicial = 0.0
        este.saldo_minimo = 0.0
        este.cheque1 = ""
        este.cheque2 = ""
    }
}

clase BeneficiarioXHB {
    key
    nombre
    categoria_key
    modo_pago
    notas

    constructor(key, nombre) {
        este.key = key
        este.nombre = nombre
        este.categoria_key = 0
        este.modo_pago = 0
        este.notas = ""
    }
}

clase CategoriaXHB {
    key
    padre_key
    banderas
    nombre

    constructor(key, nombre, banderas) {
        este.key = key
        este.nombre = nombre
        este.banderas = banderas
        este.padre_key = 0
    }
}

clase EtiquetaXHB {
    key
    nombre

    constructor(key, nombre) {
        este.key = key
        este.nombre = nombre
    }
}

clase OperacionXHB {
    fecha
    monto
    cuenta_key
    cuenta_destino_key
    modo_pago
    beneficiario_key
    categoria_key
    concepto
    etiquetas
    banderas
    estado
    kmo

    constructor(fecha, monto, cuenta_key, concepto) {
        este.fecha = fecha
        este.monto = monto
        este.cuenta_key = cuenta_key
        este.cuenta_destino_key = 0
        este.modo_pago = 0
        este.beneficiario_key = 0
        este.categoria_key = 0
        este.concepto = concepto
        este.etiquetas = ""
        este.banderas = 0
        este.estado = 0
        este.kmo = 0
    }
}

# Parsea un texto XML formato HomeBank XHB y retorna una estructura de datos.
funcion parsear(xml) {
    si (xml == nulo) {
        retornar Error(nuevo ErrorXHB("Se esperaba una cadena XML XHB no vacía", 1))
    }
    variable res = _xhb_parsear(xml)
    retornar Ok(res)
}

# Serializa una estructura de datos XHB a texto XML HomeBank con fidelidad byte a byte.
funcion serializar(datos) {
    si (datos == nulo) {
        retornar Error(nuevo ErrorXHB("Estructura XHB inválida para serializar", 2))
    }
    variable res = _xhb_serializar(datos)
    retornar Ok(res)
}

# Convierte una estructura de datos XHB a texto JSON.
funcion serializar_json(datos) {
    si (datos == nulo) {
        retornar Error("Estructura XHB inválida para serializar a JSON")
    }
    variable res = _json_stringificar(datos)
    si (res[0] != 0) {
        retornar Error(res[1])
    }
    retornar Ok(res[1])
}

# Lee un archivo .xhb y lo parsea a un objeto XHB.
funcion leer_xhb(ruta) {
    variable res_archivo = leer_archivo(ruta)
    coincidir (res_archivo) {
        caso Ok(contenido) -> {
            retornar parsear(contenido)
        }
        caso Error(err) -> {
            retornar Error(nuevo ErrorXHB("No se pudo leer el archivo XHB", 3))
        }
    }
}

# Lee un archivo .xhb, lo parsea y lo convierte a JSON.
funcion leer_xhb_como_json(ruta) {
    variable res_xhb = leer_xhb(ruta)
    coincidir (res_xhb) {
        caso Ok(datos) -> {
            retornar serializar_json(datos)
        }
        caso Error(err) -> {
            retornar Error(err)
        }
    }
}

# Serializa y guarda un objeto XHB en un archivo .xhb.
funcion guardar_xhb(ruta, datos) {
    variable res_xml = serializar(datos)
    coincidir (res_xml) {
        caso Ok(xml_texto) -> {
            retornar escribir_archivo(ruta, xml_texto)
        }
        caso Error(err) -> {
            retornar Error(err)
        }
    }
}

# Serializa y guarda un objeto XHB en un archivo .json.
funcion guardar_xhb_como_json(ruta, datos) {
    variable res_json = serializar_json(datos)
    coincidir (res_json) {
        caso Ok(texto_json) -> {
            retornar escribir_archivo(ruta, texto_json)
        }
        caso Error(err) -> {
            retornar Error(err)
        }
    }
}
