# ══════════════════════════════════════════════════════════════════════
# sandbox — Control de acceso a recursos del sistema
# ══════════════════════════════════════════════════════════════════════
#
# Por defecto, TODO está habilitado (red, archivos, procesos).
# Este módulo permite RESTRINGIR acceso cuando sea necesario.
#
# Uso:
#   importar std/sandbox
#
#   # Restringir host de red
#   sandbox.restringir_host("google.com")
#
#   # Restringir directorio de archivos
#   sandbox.restringir_directorio("/etc")
#
#   # Restringir comando de procesos
#   sandbox.restringir_comando("rm")
#
#   # Consultar estado
#   variable estado = sandbox.estado()
#   escribir(estado)  # {red: "restringido", archivos: "abierto", procesos: "abierto"}

# ─── Red ─────────────────────────────────────────────────────────────

# Restringe un host de red específico.
# Una vez que se restringe un host, solo los hosts restringidos están permitidos.
#
# Ejemplo:
#   sandbox.restringir_host("google.com")
#   sandbox.restringir_host("facebook.com")
#   # Ahora solo se puede acceder a google.com y facebook.com
funcion restringir_host(host: Texto) {
    _sandbox_restringir_host(host)
}

# Restringe un puerto de red específico.
#
# Ejemplo:
#   sandbox.restringir_puerto(80)
#   sandbox.restringir_puerto(443)
#   # Ahora solo se puede acceder a puertos 80 y 443
funcion restringir_puerto(puerto: Entero) {
    _sandbox_restringir_puerto(puerto)
}

# ─── Archivos ────────────────────────────────────────────────────────

# Restringe acceso a un directorio específico.
# Una vez que se restringe un directorio, solo los directorios restringidos están permitidos.
#
# Ejemplo:
#   sandbox.restringir_directorio("/etc")
#   sandbox.restringir_directorio("/root")
#   # Ahora solo se puede acceder a /etc y /root
funcion restringir_directorio(dir: Texto) {
    _sandbox_restringir_directorio(dir)
}

# ─── Procesos ────────────────────────────────────────────────────────

# Restringe ejecución de un comando específico.
# Una vez que se restringe un comando, solo los comandos restringidos están permitidos.
#
# Ejemplo:
#   sandbox.restringir_comando("rm")
#   sandbox.restringir_comando("chmod")
#   # Ahora solo se puede ejecutar rm y chmod
funcion restringir_comando(comando: Texto) {
    _sandbox_restringir_comando(comando)
}

# ─── Consultas ───────────────────────────────────────────────────────

# Retorna el estado actual del sandbox como un mapa.
#
# Ejemplo:
#   variable estado = sandbox.estado()
#   escribir(estado)
#   # {red: "abierto", archivos: "abierto", procesos: "abierto"}
funcion estado() {
    _sandbox_estado()
}
