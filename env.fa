# módulo: env
# Variables de entorno y configuración del sistema
#
# Uso: importar std/env
#
# Proporciona:
#   env.obtener(nombre) -> Opcion<Texto>
#   env.obtener_entero(nombre, por_defecto) -> Entero
#   env.obtener_booleano(nombre, por_defecto) -> Booleano
#   env.establecer(nombre, valor)
#   env.todos() -> Arreglo<(Texto, Texto)>
#   env.cargar_archivo(ruta) -> Resultado<(), ErrorEnv>
#   env.expandir(texto) -> Texto

importar std/resultado

clase ErrorEnv {
    mensaje: Texto
    codigo: Entero
    constructor(mensaje: Texto, codigo: Entero) {
        este.mensaje = mensaje; este.codigo = codigo
    }
}

funcion obtener(nombre: Texto) -> Opcion<Texto> {
    variable valor = _sistema_variable_entorno(nombre)
    si (valor == "") { retornar None() }
    retornar Some(valor)
}

funcion obtener_entero(nombre: Texto, por_defecto: Entero) -> Entero {
    variable raw = _sistema_variable_entorno(nombre)
    si (raw == "") { retornar por_defecto }
    variable val = _env_parsear_entero(raw)
    si (val == "") { retornar por_defecto }
    retornar val
}

funcion obtener_booleano(nombre: Texto, por_defecto: Booleano) -> Booleano {
    variable raw = _sistema_variable_entorno(nombre)
    si (raw == "") { retornar por_defecto }
    retornar _env_parsear_booleano(raw)
}

funcion establecer(nombre: Texto, valor: Texto) {
    _env_establecer(nombre, valor)
}

funcion todos() -> Arreglo<(Texto, Texto)> {
    retornar _env_todos()
}

funcion cargar_archivo(ruta: Texto) -> Resultado<(), ErrorEnv> {
    variable contenido = _archivo_leer(ruta)
    si (contenido == "") {
        retornar Error(nuevo ErrorEnv("No se pudo leer el archivo: " + ruta, 1))
    }
    _env_cargar_desde_texto(contenido)
    retornar Ok()
}

funcion expandir(texto: Texto) -> Texto {
    retornar _env_expandir(texto)
}
