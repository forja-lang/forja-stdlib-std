# módulo: toml
# Parseo y generación de TOML
# Uso: importar std/toml

importar std/resultado

clase ErrorToml {
    mensaje: Texto;
    codigo: Entero;
    constructor(m: Texto, c: Entero) {
        este.mensaje = m;
        este.codigo = c;
    }
}

# Nota: los nativos devuelven el valor crudo (mapa / texto), no un Resultado.
# Envolver en `Ok` mantiene el contrato que declara la firma.
funcion parsear(texto: Texto) -> Resultado<Mapa<Texto>, ErrorToml> {
    retornar Ok(_toml_parsear(texto));
}

funcion generar(mapa: Mapa<Texto>) -> Resultado<Texto, ErrorToml> {
    retornar Ok(_toml_generar(mapa));
}
