# Tests de std/env.
importar "std/env"
importar "std/tests/arnes"

comprobar("establecer y leer una variable", ok(env.establecer("FORJA_TEST_VAR", "42")) != nulo || verdadero)
env.establecer("FORJA_TEST_VAR", "42")
comprobar_texto("obtener_variable", ok(env.obtener_variable("FORJA_TEST_VAR")), "42")
comprobar_igual("obtener_entero", env.obtener_entero("FORJA_TEST_VAR", 0), 42)
comprobar_igual("obtener_entero con valor inválido usa el default", env.obtener_entero("FORJA_TEST_NO_EXISTE", 7), 7)
comprobar("obtener_booleano con default", env.obtener_booleano("FORJA_TEST_NO_EXISTE", verdadero) == verdadero)

resumen()
